{
  "name": "ecommerce-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "axios": "^1.2.1",
    "i18next": "25.6.1",
    "i18next-browser-languagedetector": "8.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "16.2.3",
    "react-router-dom": "^5.3.4",
    "react-scripts": "5.0.1",
    "recharts": "^2.2.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "visual:build": "node visual/build.mjs",
    "visual": "playwright test",
    "visual:shots": "playwright test screenshots.spec.ts flow.spec.ts",
    "visual:contrast": "playwright test contrast.spec.ts flow.spec.ts",
    "visual:report": "playwright show-report visual/out/playwright-report",
    "visual:typecheck": "tsc -p visual"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "prettier"
    ],
    "overrides": [
      {
        "files": [
          "**/*.ts",
          "**/*.tsx"
        ],
        "rules": {
          "@typescript-eslint/naming-convention": [
            "warn",
            {
              "selector": "variable",
              "format": [
                "camelCase",
                "PascalCase",
                "UPPER_CASE"
              ],
              "leadingUnderscore": "allow"
            },
            {
              "selector": "function",
              "format": [
                "camelCase",
                "PascalCase"
              ]
            },
            {
              "selector": "parameter",
              "format": [
                "camelCase",
                "PascalCase"
              ],
              "leadingUnderscore": "allow"
            },
            {
              "selector": "typeLike",
              "format": [
                "PascalCase"
              ]
            }
          ]
        }
      }
    ]
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!axios)/"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^25.9.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "8.26.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "sass": "1.77.8",
    "typescript": "^5.9.3"
  }
}
